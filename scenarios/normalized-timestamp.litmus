# A command whose *raw* output changes every run (it prints the current time),
# but which is DETERMINISTIC once litmus normalizes timestamps away.
#
# This demonstrates the core value proposition: distinguishing "meaningful"
# divergence from legitimate, ignorable noise. With `strip_timestamps = true`
# the varying clock is masked to `<ts>` and all runs fingerprint identically.

name = normalized-timestamp
description = Raw output varies by wall-clock time, but is stable after normalization.

[run]
command = node -e "process.stdout.write('event at ' + new Date().toISOString() + ' processed\n')"
