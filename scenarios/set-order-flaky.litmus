# A classic real-world flakiness source: relying on unordered iteration.
# In many languages, iterating a set/dict yields a nondeterministic order
# (hash randomization). Here we simulate it faithfully: we shuffle an array
# and print it. Without `sort_lines` the output diverges (flaky); the companion
# scenario `set-order-fixed.litmus` shows the fix.

name = set-order-flaky
description = Prints a shuffled collection; iteration order is nondeterministic.

[run]
command = node -e "const a=[1,2,3,4,5]; for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];} console.log(a.join(','));"
