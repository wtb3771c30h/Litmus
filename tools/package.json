{
  "name": "litmus-report",
  "version": "0.1.0",
  "description": "Dependency-free renderer and scenario authoring helper for litmus evidence.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "litmus-report": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/litmus.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  }
}
